# Copy to .env.local for local development, and add the same names in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "Publishable" key (sb_publishable_...). The legacy "anon" key also works here. Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "Secret" key (sb_secret_...). The legacy "service_role" key also works here.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste in chats.
SUPABASE_SECRET_KEY=

# The public address of the website, without a trailing slash. Used in Telegram buttons, emails and the sitemap.
NEXT_PUBLIC_SITE_URL=https://jordipastry.example

# Telegram owner alerts (see docs/TELEGRAM_SETUP.md). Leave empty to disable; orders still work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/cron/attention (unpaid-order reminders). Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
